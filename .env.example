# ---- LLM (viet script + nghien cuu so sanh) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- VieNeu-TTS (chay local, xem scripts/setup_vieneu.sh) ----
VIENEU_BASE_URL=http://127.0.0.1:8000
VIENEU_API_KEY=

# ---- Nguon anh/video mien phi (dang ky free, khong bat buoc het) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Openverse / Wikimedia Commons / NASA / Met Museum: khong can key

# ---- Du lieu kinh te (mien phi, khong can key tru FRED) ----
FRED_API_KEY=

# ---- YouTube upload (tuy chon) ----
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
