# ============ LLM ============
# Mac dinh: DeepSeek. Tao key tai platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Hoac chay mien phi tren GPU cua ban, khong can key:
#   ollama pull qwen2.5:14b
#   autovid run latest --set llm.provider=ollama --set llm.model_script=qwen2.5:14b

# ============ VieNeu-TTS (chay local, xem scripts/setup.sh) ============
VIENEU_BASE_URL=http://127.0.0.1:8000
VIENEU_API_KEY=

# ============ Tim kiem web ============
# Khong bat buoc. Khong co key nao thi tu dong dung DuckDuckGo.
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# ============ Nguon anh/video ============
# Khong bat buoc. Openverse / Wikimedia / NASA / Internet Archive khong can key.
# Them 2 key duoi day (mien phi) neu muon B-roll video dep hon.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ============ YouTube upload (tuy chon, mac dinh tat) ============
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
